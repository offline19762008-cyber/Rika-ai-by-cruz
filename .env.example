# === Required ===
TELEGRAM_TOKEN=your_telegram_bot_token
OPENROUTER_KEY=your_openrouter_api_key

# === Optional ===
# AI model (default: deepseek/deepseek-chat)
MODEL_NAME=deepseek/deepseek-chat
# API endpoint (default: OpenRouter)
API_BASE_URL=https://openrouter.ai/api/v1
# Force-join channel (default: @AbdulBotzOfficial)
REQUIRED_CHANNEL=@AbdulBotzOfficial

# === Admin / Sudo Powers ===
# Your Telegram user ID (the bot owner). Find it via @userinfobot
OWNER_ID=0
# Comma-separated extra admin user IDs that share sudo powers
SUDO_USERS=
